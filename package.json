{
  "name": "volley-live",
  "private": true,
  "description": "Development tooling for VolleyLive (formatting, lint and unit tests). The app itself has no build step.",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"tests/unit/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}

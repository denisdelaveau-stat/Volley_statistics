#!/bin/sh
# Stamps the branch name and build number into index.html and sw.js (tools/stamp_build.py).
# Enable once per clone: git config core.hooksPath .githooks
if command -v python3 >/dev/null 2>&1 && python3 -c "" >/dev/null 2>&1; then
  PY=python3
else
  PY=python
fi
exec "$PY" "$(git rev-parse --show-toplevel)/tools/stamp_build.py"
